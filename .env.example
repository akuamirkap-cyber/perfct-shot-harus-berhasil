# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional AdMob configuration for Android APK/AAB builds (Capacitor).
# Leave empty to use Google's official AdMob test IDs safely while testing.
VITE_ADMOB_APP_ID=""
VITE_ADMOB_REWARDED_ID=""
VITE_ADMOB_TEST_MODE="true"

# Voodoo Publishing Analytics (GameAnalytics + Adjust + Facebook) for Android .aab builds.
# Fill these in your local `.env` file (never commit real Secret Keys to Git).
VITE_VOODOO_GA_GAME_KEY=""
VITE_VOODOO_GA_SECRET_KEY=""
VITE_VOODOO_ADJUST_TOKEN=""
VITE_VOODOO_ADJUST_SANDBOX="false"
VITE_VOODOO_FB_APP_ID=""
VITE_VOODOO_FB_CLIENT_TOKEN=""

# GDPR consent pop-up on Android native launch ("true" recommended for EU/global builds).
VITE_VOODOO_REQUIRE_GDPR="true"
